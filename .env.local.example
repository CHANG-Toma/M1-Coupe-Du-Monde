# API Football (api-football.com)
# Obtenez une clé sur https://www.api-football.com/
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Mettre à "true" pour utiliser les données mockées (développement sans clé API)
USE_MOCK_DATA=true

# PostgreSQL — fallback si l'API est indisponible
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cdm:cdm2026@localhost:5432/cdm2026
