# API Football (api-football.com) — données CDM 2026 en temps réel
# Créez un compte gratuit : https://www.api-football.com/
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# false = utilise l'API réelle (nécessite une clé valide ci-dessus)
USE_MOCK_DATA=false

# Intervalle de rafraîchissement client (ms) — 30s recommandé pour le quota API
NEXT_PUBLIC_POLL_INTERVAL_MS=30000

# PostgreSQL — fallback si l'API est indisponible
DATABASE_URL=postgresql://cdm:cdm2026@localhost:5432/cdm2026
