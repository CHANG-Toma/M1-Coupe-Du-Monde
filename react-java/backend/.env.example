# PostgreSQL (Docker)
spring.datasource.url=jdbc:postgresql://localhost:5432/cdm2026
spring.datasource.username=cdm
spring.datasource.password=cdm2026

# Mettre à true pour forcer les données mock locales (sans BDD ni API)
app.use-mock-data=false
app.worldcup2026.api-url=https://worldcup26.ir

# Synchronisation catalogue → PostgreSQL (toutes les 5 min)
app.sync.enabled=true
app.sync.interval-ms=300000
